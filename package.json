{
  "name": "nano-cortex-editor",
  "productName": "Nano Cortex Editor",
  "version": "1.2.1",
  "private": true,
  "description": "Unofficial desktop editor for the Neural DSP Nano Cortex (macOS, Windows and Linux): presets, every block, captures, footswitches, expression, tempo, tuner, metronome and Cortex Cloud capture/IR transfer over Bluetooth.",
  "main": "src/main.js",
  "license": "MIT",
  "author": "AJs Creations",
  "homepage": "https://github.com/AJs-Creations/nano-cortex-editor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJs-Creations/nano-cortex-editor.git"
  },
  "bugs": {
    "url": "https://github.com/AJs-Creations/nano-cortex-editor/issues"
  },
  "scripts": {
    "build:core": "node scripts/build-core.js",
    "start": "npm run build:core && node scripts/run-electron.js .",
    "dist": "npm run build:core && npm run build:icon && electron-builder --mac --arm64 --x64",
    "dist:linux": "npm run build:core && electron-builder --linux --x64 --arm64",
    "build:preview": "node scripts/build-core.js && node scripts/build-preview.js",
    "test:ux": "npm run build:core && node scripts/run-electron.js test/ux-test.js",
    "build:icon": "node scripts/run-electron.js scripts/build-icon.js",
    "docs:screenshots": "npm run build:core && node scripts/run-electron.js scripts/docs-screenshots.js && python3 scripts/docs-images.py"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.ajs-creations.nano-cortex-editor",
    "productName": "Nano Cortex Editor",
    "files": [
      "src/**",
      "assets/icon.svg",
      "editor/**",
      "pro/**",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Nano Cortex Editor connects to your Nano Cortex over Bluetooth to read and edit presets.",
        "NSBluetoothPeripheralUsageDescription": "Nano Cortex Editor connects to your Nano Cortex over Bluetooth.",
        "NSMicrophoneUsageDescription": "Only needed to list your audio outputs for the metronome; the microphone is never recorded.",
        "CFBundleDisplayName": "Nano Cortex Editor",
        "LSApplicationCategoryType": "public.app-category.music"
      },
      "icon": "build/icon.icns"
    },
    "copyright": "Copyright © 2026 AJs Creations. Unofficial; not affiliated with or endorsed by Neural DSP.",
    "publish": [
      {
        "provider": "github",
        "owner": "AJs-Creations",
        "repo": "nano-cortex-editor"
      }
    ],
    "dmg": {
      "writeUpdateInfo": false
    },
    "artifactName": "nano-cortex-editor-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "nano-cortex-editor-${version}-${os}-${arch}-portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "maintainer": "AJs Creations",
      "synopsis": "Unofficial editor for the Neural DSP Nano Cortex",
      "executableName": "nano-cortex-editor",
      "desktop": {
        "entry": {
          "Name": "Nano Cortex Editor",
          "StartupWMClass": "Nano Cortex Editor"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "nano-cortex-editor-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "nano-cortex-editor_${version}_${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.10"
  }
}
